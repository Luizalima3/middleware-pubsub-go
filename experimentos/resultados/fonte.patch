+func TestCPUUsaTempoDoProcessoESemLimitarAUmNucleo(t *testing.T) {
+	if v := percentualCPU(Processo{CPUSegundos: 4}, Processo{CPUSegundos: 5}, 2); v != 50 {
+		t.Fatal(v)
+	}
+	if v := percentualCPU(Processo{}, Processo{CPUSegundos: 3}, 2); v != 150 {
+		t.Fatal(v)
+	}
