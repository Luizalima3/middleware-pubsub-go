+}
+
+func TestColetaRecursosReaisECSVSemSobrescrever(t *testing.T) {
+	p, err := LerProcesso()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if p.RAMBytes == 0 {
+		t.Fatal("RAM não foi coletada")
+	}
+	path := filepath.Join(t.TempDir(), "metricas.csv")
+	c, err := Iniciar(context.Background(), path, 10*time.Millisecond, func() []Fila {
+		return []Fila{{Tipo: "topico", Nome: "a,b", Estado: fila.Estado{Itens: 2, Bytes: 10, LimiteItens: 4, LimiteBytes: 20, PicoItens: 3, PicoBytes: 15}}}
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	time.Sleep(35 * time.Millisecond)
+	if err = c.Fechar(); err != nil {
+		t.Fatal(err)
+	}
+	f, err := os.Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	rows, err := csv.NewReader(f).ReadAll()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(rows) < 3 || rows[1][5] != "" || rows[2][5] == "" {
+		t.Fatal(rows)
+	}
+	for _, row := range rows[1:] {
+		if row[11] != "a,b" || row[12] != "2" || row[14] != "4" || row[16] != "3" {
+			t.Fatal(row)
+		}
+		ram, e := strconv.ParseUint(row[8], 10, 64)
+		if e != nil || ram == 0 {
+			t.Fatal(row)
+		}
+	}
+	if _, err = Iniciar(context.Background(), path, time.Second, func() []Fila { return nil }); err == nil {
+		t.Fatal("sobrescreveu dados existentes")
+	}
+}
diff --git a/internal/metricas/processo.go b/internal/metricas/processo.go
new file mode 100644
index 0000000..ef843f1
--- /dev/null
+++ b/internal/metricas/processo.go
@@ -0,0 +1,18 @@
+// Package metricas registra recursos do próprio processo e fotografias de filas.
+package metricas
+
+// Processo usa CPU acumulada de usuário + kernel e RAM residente atual.
+// RAM não é heap Go, memória virtual, pico histórico ou memória de toda a máquina.
+type Processo struct {
+	CPUSegundos float64
+	RAMBytes    uint64
+}
+
+func LerProcesso() (Processo, error) { return lerProcesso() }
+
+func percentualCPU(anterior, atual Processo, segundos float64) float64 {
+	if segundos <= 0 || atual.CPUSegundos < anterior.CPUSegundos {
+		return 0
+	}
+	return (atual.CPUSegundos - anterior.CPUSegundos) / segundos * 100
+}
diff --git a/internal/metricas/processo_linux.go b/internal/metricas/processo_linux.go
new file mode 100644
index 0000000..be34a69
--- /dev/null
+++ b/internal/metricas/processo_linux.go
@@ -0,0 +1,32 @@
+//go:build linux
+
+package metricas
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+	"syscall"
+)
+
+func lerProcesso() (Processo, error) {
+	var r syscall.Rusage
+	if err := syscall.Getrusage(syscall.RUSAGE_SELF, &r); err != nil {
+		return Processo{}, err
+	}
+	d, err := os.ReadFile("/proc/self/statm")
+	if err != nil {
+		return Processo{}, err
+	}
+	campos := strings.Fields(string(d))
+	if len(campos) < 2 {
+		return Processo{}, fmt.Errorf("statm inválido")
+	}
+	pages, err := strconv.ParseUint(campos[1], 10, 64)
+	if err != nil {
+		return Processo{}, err
+	}
+	cpu := float64(r.Utime.Sec+r.Stime.Sec) + float64(r.Utime.Usec+r.Stime.Usec)/1e6
+	return Processo{CPUSegundos: cpu, RAMBytes: pages * uint64(os.Getpagesize())}, nil
+}
